# ---- Backend ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
# Optional cheaper fallback; only used when GEMINI_USE_FALLBACK_MODEL=true
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_USE_FALLBACK_MODEL=false

DATA_DIR=./data
DATABASE_URL=sqlite:///strategies.db
CORS_ORIGINS=http://localhost:5173,https://easybacktest.pages.dev

# Nightly refresh (07:00 Asia/Seoul)
ENABLE_SCHEDULER=true

# ---- Frontend (frontend/.env) ----
VITE_API_BASE_URL=http://localhost:5173
